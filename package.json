{
  "name": "wplacebot",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "bun src/build.ts",
    "build:check": "bun src/build.ts --check",
    "check": "stylelint \"src/**/*.{css,scss,sass}\" && eslint \"src/**/*{.js,.ts}\" && tsc --noEmit --composite false --incremental false && bun test",
    "copy": "bun run build && wl-copy < dist.user.js",
    "fix": "bun run lint",
    "lint": "stylelint \"src/**/*.{css,scss,sass}\" --fix && eslint \"src/**/*{.js,.ts}\" --fix && tsc",
    "test": "bun test"
  },
  "devDependencies": {
    "@softsky/configs": "^1.5.2",
    "@types/bun": "^1.3.14"
  },
  "dependencies": {
    "@softsky/utils": "^2.8.4"
  }
}
